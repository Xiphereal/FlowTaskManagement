<Window x:Class="DRGiudflgh.TaskCreation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Task creation" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel>
            <Label Content="_Name:" Target="{Binding ElementName=Name}" />
            <TextBox Name="Name" />
            <Label Content="_Description:" Target="{Binding ElementName=Description}" />
            <TextBox Name="Description" Height="75" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalAlignment="Stretch" />
            <Button Content="Add" HorizontalAlignment="Right" Click="SaveTask"/>
        </StackPanel>
    </Grid>
</Window>