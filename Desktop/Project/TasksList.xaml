<UserControl x:Class="Desktop.Project.TasksList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:domain="clr-namespace:Desktop.Domain">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Tasks:" />
                <Button AutomationProperties.AutomationId="AddTask" Content="_Add task" Command="{Binding Add}" />
            </StackPanel>

            <ListBox Name="Tasks">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:Task}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                            <Button Content="Edit"
                                    Command="{Binding DataContext.Edit, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Delete"
                                    Command="{Binding DataContext.Delete, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>