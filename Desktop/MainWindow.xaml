<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:backendAvailabilityConverters="clr-namespace:Desktop.BackendAvailability.Converters"
        mc:Ignorable="d"
        Title="Flow Task Management"
        WindowState="Maximized"
        Icon="Resources\Icon.ico"
        AutomationProperties.AutomationId="TasksAppMainWindow">
    <Window.Resources>
        <backendAvailabilityConverters:BoolToImageConverter x:Key="BoolToImageConverter">
            <backendAvailabilityConverters:BoolToImageConverter.BackendAvailable>
                <BitmapImage UriSource="pack://application:,,,/BackendAvailability/Resources/BackendAvailable.png" />
            </backendAvailabilityConverters:BoolToImageConverter.BackendAvailable>
            <backendAvailabilityConverters:BoolToImageConverter.BackendUnavailable>
                <BitmapImage UriSource="pack://application:,,,/BackendAvailability/Resources/BackendUnavailable.png" />
            </backendAvailabilityConverters:BoolToImageConverter.BackendUnavailable>
        </backendAvailabilityConverters:BoolToImageConverter>

        <backendAvailabilityConverters:BoolToAvailabilityTextConverter x:Key="BoolToAvailabilityTextConverter" />
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <Image Width="32"
                       Height="32"
                       ToolTip="{Binding IsBackendAvailable, Converter={StaticResource BoolToAvailabilityTextConverter}}"
                       Source="{Binding IsBackendAvailable, Converter={StaticResource BoolToImageConverter}}" />
            </StatusBarItem>
            <StatusBarItem>
                <Label
                    Content="{Binding IsBackendAvailable, Converter={StaticResource BoolToAvailabilityTextConverter}}" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="{StaticResource DefaultMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="{StaticResource DefaultMargin}">
                <Label HorizontalAlignment="Center">Views</Label>
                <Menu>
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Header="_1 - Tasks List" Click="NavigateToTaskList" />
                    <MenuItem Header="_2 - Project Tree" Click="NavigateToProjectTree" />
                </Menu>
            </StackPanel>
            <GridSplitter Grid.Column="1" Width="5" />
            <ContentControl Grid.Column="2" Margin="{StaticResource DefaultMargin}" Name="Content" />
        </Grid>
    </DockPanel>
</Window>