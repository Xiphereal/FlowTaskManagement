<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:backendAvailabilityConverters="clr-namespace:Desktop.BackendAvailability.Converters"
        mc:Ignorable="d"
        Title="Flow Task Management"
        WindowState="Maximized"
        Icon="Resources\Icon.ico"
        AutomationProperties.AutomationId="TasksAppMainWindow">
    <Window.Resources>
        <backendAvailabilityConverters:BoolToImageConverter x:Key="BoolToImageConverter">
            <backendAvailabilityConverters:BoolToImageConverter.BackendAvailable>
                <BitmapImage UriSource="pack://application:,,,/BackendAvailability/Resources/BackendAvailable.png" />
            </backendAvailabilityConverters:BoolToImageConverter.BackendAvailable>
            <backendAvailabilityConverters:BoolToImageConverter.BackendUnavailable>
                <BitmapImage UriSource="pack://application:,,,/BackendAvailability/Resources/BackendUnavailable.png" />
            </backendAvailabilityConverters:BoolToImageConverter.BackendUnavailable>
        </backendAvailabilityConverters:BoolToImageConverter>

        <backendAvailabilityConverters:BoolToAvailabilityTextConverter x:Key="BoolToAvailabilityTextConverter" />

        <!-- This style is required since the Fluent theme currently applied ControlTemplate arranges top-level items 
             with its own horizontal panel. Setting ItemsPanel directly on Menu, as done previously, doesn't touch that
             panel, so MenuItems stay horizontal. -->
        <Style x:Key="VerticalMenu" TargetType="{x:Type Menu}" BasedOn="{StaticResource {x:Type Menu}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Menu}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <!-- ItemsPresenter ensures ItemsPanelTemplate below is honored -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Now this actually controls the top-level layout -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <Image Width="32"
                       Height="32"
                       ToolTip="{Binding IsBackendAvailable, Converter={StaticResource BoolToAvailabilityTextConverter}}"
                       Source="{Binding IsBackendAvailable, Converter={StaticResource BoolToImageConverter}}" />
            </StatusBarItem>
            <StatusBarItem>
                <Label
                    Content="{Binding IsBackendAvailable, Converter={StaticResource BoolToAvailabilityTextConverter}}" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="{StaticResource DefaultMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="{StaticResource DefaultMargin}">
                <Label HorizontalAlignment="Center">Views</Label>
                <Menu Style="{StaticResource VerticalMenu}">
                    <MenuItem Header="_1 - Tasks List" Click="NavigateToTaskList" />
                    <MenuItem Header="_2 - Project Tree" Click="NavigateToProjectTree" />
                </Menu>
            </StackPanel>
            <Separator Grid.Column="1" Width="5" />
            <ContentControl Grid.Column="2" Margin="{StaticResource DefaultMargin}" Name="Content" />
        </Grid>
    </DockPanel>
</Window>